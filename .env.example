# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (SQLite default for zero-config local run, or PostgreSQL)
DATABASE_URL="file:./dev.db"

# NVIDIA NIM Integration
# Enter your NVIDIA NIM API Key (from build.nvidia.com)
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_DEFAULT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_secret_in_production
