# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration
DATABASE_URL="file:./dev.db"

# AI Provider Integration (NVIDIA NIM)
AI_API_KEY=nvapi-your_nvidia_api_key_here
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_DEFAULT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Supported Models:
# - nvidia/nemotron-3.5-super-vl-120b-a12b (Advanced Multimodal Clinical Reasoning)
# - nvidia/nemotron-3.5-lightning-30b-a3b (Rapid Clinical Triage & Guidance)
# - nvidia/nemotron-3-nano-omni-30b-a3b-reasoning (Deep Reasoning & Clinical Analysis)

# Security & Authentication
JWT_SECRET=healhealth-super-secret-jwt-key-2026-production
